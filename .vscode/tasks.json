{
	"tasks": [
		{
			"label": "Run clang-tidy",
			"type": "shell",
			"command": "make tidy -j$(nproc)",
			"group": {
				"kind": "build",
				"isDefault": true
			},
			"problemMatcher": {
				"owner": "cpp",
				"fileLocation": [
					"absolute",
				],
				"pattern": {
					"regexp": "^(.*):(\\d+):(\\d+):\\s+(warning|error):\\s+(.*)$",
					"file": 1,
					"line": 2,
					"column": 3,
					"severity": 4,
					"message": 5
				}
			},
			"presentation": {
				"reveal": "never",
			}
		},
		{
			"label": "build",
			"type": "shell",
			"command": "make -j$(nproc)",
			"problemMatcher": []
		}
	],
	"version": "2.0.0"
}